# ---------------------------------------------------------------------------
# CourseLLM — example environment file.
#
# Copy to `.env` and fill in. NOTHING in this file is a real secret.
# Every value below has a working default for local development, except the
# ones explicitly marked REQUIRED.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=local                     # local | dev | prod
DEBUG=true
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                    # console | json
API_V1_PREFIX=/api/v1

# --- Security --------------------------------------------------------------
# REQUIRED in prod. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(64))"
# In prod the app refuses to start if this is left at the placeholder value.
SECRET_KEY=change-me-in-production-not-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Per-tenant / per-user limits. Denial-of-wallet protection.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_LLM_REQUESTS_PER_HOUR=200
MAX_QUERY_CHARS=2000
MAX_UPLOAD_BYTES=26214400               # 25 MiB
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.txt,.md,.markdown,.docx

# Prompt-injection detector. Score in [0,1]; at or above block => refuse.
INJECTION_WARN_THRESHOLD=0.4
INJECTION_BLOCK_THRESHOLD=0.75
INJECTION_LLM_CLASSIFIER_ENABLED=false

# --- Database --------------------------------------------------------------
# Two roles, mirroring production:
#   DATABASE_URL           the application role. Must be NOSUPERUSER NOBYPASSRLS,
#                          otherwise PostgreSQL ignores Row-Level Security and
#                          tenant isolation silently disappears.
#   ALEMBIC_DATABASE_URL   the schema owner, used only by migrations.
# `make db-setup` creates both locally and grants the privileges each needs.
DATABASE_URL=postgresql+asyncpg://coursellm_app@localhost:5432/coursellm_dev
ALEMBIC_DATABASE_URL=postgresql+asyncpg://localhost:5432/coursellm_dev
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis -----------------------------------------------------------------
# Optional. When unreachable, caching is bypassed and rate limiting fails open
# with a warning; the app does not fail to start.
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

# --- LLM gateway (LiteLLM) -------------------------------------------------
# With LLM_ENABLED=false the system runs fully offline: retrieval, reranking,
# graph queries and evaluation work, and generation degrades to a grounded
# extractive answer. This is how CI runs.
LLM_ENABLED=true
PRIMARY_MODEL=openai/gpt-4o-mini
FALLBACK_MODEL=anthropic/claude-3-5-haiku-latest
FAST_MODEL=openai/gpt-4o-mini          # classification / routing / extraction
REASONING_MODEL=openai/gpt-4o          # complex tutoring / roadmaps
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_ROUTING_ENABLED=true
LLM_MAX_INPUT_TOKENS=8000
LLM_MAX_OUTPUT_TOKENS=1500

# Provider keys. Only the ones you intend to use are required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Embeddings ------------------------------------------------------------
# `local`     -> sentence-transformers, no network, no cost
# `litellm`   -> provider embedding API through the LiteLLM gateway
# `hashing`   -> deterministic, dependency-free; used by CI and unit tests
# `local` requires the optional `embeddings` extra (PyTorch). The default Docker
# API image installs core + docx only, so use `hashing` there or build it with
# INSTALL_EXTRAS=embeddings. See docker/README.md.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# --- Reranking -------------------------------------------------------------
RERANK_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=5
RERANK_BATCH_SIZE=16
RERANK_TIMEOUT_MS=5000
RERANK_MIN_SCORE=-8.0                   # raw logit floor; below this, drop

# --- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K_PER_RETRIEVER=20
RRF_K=60
BM25_K1=1.2
BM25_B=0.75
HNSW_EF_SEARCH=100
CONTEXT_TOKEN_BUDGET=3000
METADATA_FILTERING_ENABLED=true

# --- Ingestion -------------------------------------------------------------
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=80
MIN_CHUNK_TOKENS=24
INGESTION_MAX_CONCURRENCY=2

# --- Knowledge graph -------------------------------------------------------
GRAPH_EXTRACTION_ENABLED=true
# Leave empty to fall back to FAST_MODEL. Keep the comment on its own line:
# compose's env_file parser (unlike python-dotenv) reads a `#` that follows an
# empty `=` as the value.
GRAPH_EXTRACTION_MODEL=
GRAPH_MAX_EXTRACTION_CHUNKS_PER_DOCUMENT=200
GRAPH_MAX_EDGES_PER_CHUNK=20
GRAPH_MAX_EDGES_PER_DOCUMENT=200
GRAPH_CROSS_COURSE_EDGES=false
GRAPH_EXTRACTION_PROMPT_VERSION=graph-extract-v1
GRAPH_MAX_DEPTH=3
GRAPH_MIN_TRAVERSABLE_CONFIDENCE=0.60
GRAPH_STATEMENT_TIMEOUT_MS=1500
# Multi-signal confidence model. The five weights must sum to 1.0; startup fails
# with a clear error if they do not. See docs/architecture/knowledge-graph.md.
GRAPH_LLM_CONFIDENCE_CAP=0.80
GRAPH_AUTO_ACCEPT_CONFIDENCE=0.75
GRAPH_REVIEW_FLOOR_CONFIDENCE=0.50
GRAPH_W_BASE=0.15
GRAPH_W_LLM=0.25
GRAPH_W_CORROBORATION=0.30
GRAPH_W_CUE=0.20
GRAPH_W_AGREEMENT=0.10

# --- Learning and recommendations ------------------------------------------
# Mastery is a weighted combination of three readings of the evidence; the
# weights must sum to 1.0. Recommendations combine four contributions, also
# summing to 1.0. Startup validates both.
MASTERY_MEAN_WEIGHT=0.5
MASTERY_BEST_WEIGHT=0.3
MASTERY_LATEST_WEIGHT=0.2
RECOMMEND_WEIGHT_COVERAGE=0.55
RECOMMEND_WEIGHT_DIFFICULTY=0.20
RECOMMEND_WEIGHT_TRUST=0.15
RECOMMEND_WEIGHT_RECENCY=0.10
RECOMMEND_MIN_GAP_WEIGHT=0.1

# --- Observability ---------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=coursellm-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SAMPLE_RATIO=1.0
METRICS_ENABLED=true

# LangSmith is optional and off by default.
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=coursellm
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Capturing raw prompts in traces is OFF by default: prompts contain student
# document text. Enable only on a trusted, non-production environment.
CAPTURE_PROMPTS_IN_TRACES=false

# --- Evaluation ------------------------------------------------------------
EVAL_DATASET_PATH=evals/datasets/golden_rag.jsonl
EVAL_BASELINE_PATH=evals/reports/baseline.json
EVAL_SAMPLE_LIMIT=0                     # 0 = all

# --- Prompts ---------------------------------------------------------------
# Defaults to <repo root>/prompts. Override for containerised deployments.
PROMPTS_DIR=

# --- CORS ------------------------------------------------------------------
# Comma-separated. Never "*" together with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Docker compose (local stack) ------------------------------------------
# Read by docker-compose.yml. SECRET_KEY (above), POSTGRES_DB and POSTGRES_USER
# are required by the stack; every other value here has a working default in the
# compose file. POSTGRES_DB/USER are referenced without a `${VAR:-default}`
# because they appear inside connection URLs, and a `:-` there would look like a
# `user:password@host` credential to scripts/scan_secrets.sh.
# The compose stack always overrides DATABASE_URL, ALEMBIC_DATABASE_URL,
# REDIS_URL, PROMPTS_DIR and OTEL_EXPORTER_OTLP_ENDPOINT with in-network
# addresses, so the localhost defaults earlier in this file are for running the
# API outside Docker and are ignored inside it.
POSTGRES_DB=coursellm
POSTGRES_USER=coursellm_owner    # schema owner: runs migrations, then the role bootstrap
POSTGRES_PORT=5432               # host port only; the container always listens on 5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=5173                    # host port for the static web image
# Extra Python extras baked into the API image. Empty installs core + docx only.
# `embeddings,rerank` pulls PyTorch and multiplies the image size; see
# docker/README.md. Not needed for the default compose stack.
INSTALL_EXTRAS=
# Build-time API origin inlined into the web bundle. Empty means same-origin,
# which is what the compose nginx proxy provides. Must be a public URL.
VITE_API_BASE_URL=
