# Copy to terraform.tfvars (gitignored) and edit. `terraform.tfvars` itself is
# never committed; this example is the only .tfvars-shaped file in the tree, and
# it contains no credentials because every credential in this configuration is
# generated by Terraform and stored in Secrets Manager.
#
# The Makefile's `tf-plan` target points at this file:
#
#     make tf-plan
#
# which runs, from the repository root:
#
#     terraform -chdir=infra/terraform/environments/dev plan -var-file=terraform.tfvars.example
#
# Nothing here is applied. See ../../README.md.

project     = "coursellm"
environment = "dev"
aws_region  = "us-east-1"

availability_zones = ["us-east-1a", "us-east-1b"]

# Where CloudWatch alarm notifications go. Empty creates the topic with no
# subscriber; an email subscription must be confirmed before it delivers.
alarm_email = ""

# The deploy pipeline supplies the git SHA. `bootstrap` is a placeholder so a
# plan works before the first image is pushed, and it is deliberately not
# `latest`: a task definition must name an immutable artefact.
api_image_tag = "bootstrap"
web_image_tag = "bootstrap"

# Sizing. These defaults are the smallest defensible dev configuration. Raising
# api_cpu/api_memory beyond 512/1024 is the first thing to do if the ADOT
# sidecar and the API are starved of memory.
api_cpu   = 512
api_memory = 1024
api_desired_count = 1
api_min_capacity  = 1
api_max_capacity  = 2

web_cpu           = 256
web_memory        = 512
web_desired_count = 1

# Database and cache keep their smallest defaults (db.t4g.micro, cache.t4g.micro,
# one node, one day of backups). Override only with a reason.
# db_instance_class = "db.t4g.micro"
# cache_node_type   = "cache.t4g.micro"

# dev does not use CloudFront. Set to true to exercise the distribution in a
# non-production account.
enable_cloudfront = false

# An ACM certificate for the ALB. Empty keeps dev on HTTP, which is acceptable
# only because dev carries synthetic data.
# alb_certificate_arn = "arn:aws:acm:us-east-1:111122223333:certificate/REPLACE_ME"

# CORS origin for the browser client.
cors_allowed_origins = "http://localhost:5173"
