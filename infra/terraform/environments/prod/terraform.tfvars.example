# Copy to terraform.tfvars (gitignored) and edit. `terraform.tfvars` is never
# committed. This example contains no credentials: every credential in this
# configuration is generated by Terraform and stored in Secrets Manager.
#
# Unlike dev, `make tf-plan` targets the dev example file. To plan prod
# explicitly:
#
#     terraform -chdir=infra/terraform/environments/prod init -backend=false
#     terraform -chdir=infra/terraform/environments/prod plan -var-file=terraform.tfvars.example
#
# Nothing here is applied. See ../../README.md.

project     = "coursellm"
environment = "prod"
aws_region  = "us-east-1"

availability_zones = ["us-east-1a", "us-east-1b"]

# prod enables the billing alarm only in us-east-1, where EstimatedCharges exists.
alarm_email = ""
billing_alarm_threshold_usd = 200

# TLS. Prod expects an ACM certificate for the ALB and, if a custom domain is
# used, a second one in us-east-1 for CloudFront.
alb_certificate_arn = ""

enable_cloudfront       = true
cloudfront_price_class  = "PriceClass_100"
cloudfront_acm_certificate_arn = ""
cloudfront_aliases             = []

# After the first apply, set this to the CloudFront domain so the browser client
# may call the API cross-origin.
cors_allowed_origins = ""

# The deploy pipeline supplies the git SHA. `bootstrap` is a placeholder and is
# deliberately not `latest`.
api_image_tag = "bootstrap"
web_image_tag = "bootstrap"

# Compute sizing. Multi-AZ database and a two-node cache are the prod defaults.
api_cpu           = 1024
api_memory        = 2048
api_desired_count = 2
api_min_capacity  = 2
api_max_capacity  = 10

web_cpu           = 512
web_memory        = 1024
web_desired_count = 2
web_min_capacity  = 1
web_max_capacity  = 4

migrate_cpu    = 1024
migrate_memory = 2048

# Multi-AZ, 14 days of backups, deletion protection and no skip-final-snapshot
# are set in main.tf rather than exposed here, so they cannot be turned off by
# editing a variable file. The sizing below can be raised.
db_instance_class        = "db.t4g.medium"
db_allocated_storage     = 100
db_max_allocated_storage = 500
db_multi_az              = true
db_backup_retention_period = 14

cache_node_type              = "cache.t4g.small"
cache_num_cache_clusters     = 2
cache_snapshot_retention_limit = 7

# Trace sampling is set in the application, not the collector.
otel_sample_ratio = "0.1"

log_retention_days = 90
