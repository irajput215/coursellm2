# CourseLLM web client — build-time configuration.
#
# Copy to `.env.local` for local development. Every value is inlined into the
# built bundle by Vite, so nothing secret belongs here: the API is authenticated
# with short-lived bearer tokens issued at runtime, never with a build-time key.

# Base URL of the API. Leave empty for same-origin deployments (the default):
# the dev server proxies `/api` to http://localhost:8000 and production serves
# the static bundle behind the same origin as the API.
VITE_API_BASE_URL=

# Override only to point the dev-server proxy at a different API instance.
VITE_DEV_API_TARGET=http://localhost:8000
